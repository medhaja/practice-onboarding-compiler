# Everything works without these. Set them only to try the LLM semantic check.
# Also run: pip install -r requirements-llm.txt
#
# Any LiteLLM model name, e.g. anthropic/claude-sonnet-5-5 or openai/gpt-4o-mini
LLM_MODEL=
# The provider key LiteLLM expects for that model
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: fixed port (default: 8000, or the next free one) and review database path
PORT=
REVIEW_DB=
